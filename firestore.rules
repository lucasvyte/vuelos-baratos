rules_version = '2';
// Reglas de Firestore de Vuelos Baratos (proyecto vuelos-baratos-40152).
// Se pegan en la consola de Firebase: Firestore Database → Reglas → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function lista(lid) { return get(/databases/$(database)/documents/listas/$(lid)).data; }
    function isMember(lid) { return signedIn() && request.auth.uid in lista(lid).members; }
    function optStr(d, k, n) { return !(k in d) || (d[k] is string && d[k].size() <= n); }

    // Código de invitación → lista. Se puede leer uno por uno si sabés el código, nunca listarlos.
    match /codigos/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && code.matches('[A-Z2-9]{6}')
        && request.resource.data.keys().hasOnly(['lista'])
        && request.auth.uid in getAfter(/databases/$(database)/documents/listas/$(request.resource.data.lista)).data.members
        && getAfter(/databases/$(database)/documents/listas/$(request.resource.data.lista)).data.code == code;
    }

    // Listas: solo las ven sus miembros. Cada uno puede sumarse o irse a sí mismo, nada más.
    match /listas/{lid} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'owner', 'members', 'memberInfo', 'code', 'at'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.memberInfo.keys().hasOnly([request.auth.uid])
        && request.resource.data.code is string && request.resource.data.code.matches('[A-Z2-9]{6}')
        && optStr(request.resource.data, 'name', 60) && optStr(request.resource.data, 'at', 40);
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberInfo'])
        && request.resource.data.memberInfo.diff(resource.data.memberInfo).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.members.size() <= 10
        && (
          // sumarse
          (!(request.auth.uid in resource.data.members)
            && request.resource.data.members.hasAll(resource.data.members)
            && request.resource.data.members.size() == resource.data.members.size() + 1
            && request.auth.uid in request.resource.data.members)
          ||
          // irse
          (request.auth.uid in resource.data.members
            && resource.data.members.hasAll(request.resource.data.members)
            && request.resource.data.members.size() == resource.data.members.size() - 1
            && !(request.auth.uid in request.resource.data.members))
          ||
          // actualizar su propio nombre
          (request.auth.uid in resource.data.members
            && request.resource.data.members == resource.data.members)
        );

      // Precios anotados: los leen y escriben solo los miembros de la lista
      match /precios/{id} {
        allow read, delete: if isMember(lid);
        allow create, update: if isMember(lid)
          && id.matches('[a-z0-9]{1,24}')
          && request.resource.data.keys().hasOnly(['id', 'src', 'srcName', 'url', 'route', 'dates', 'airline', 'amount', 'cur', 'final', 'at', 'by'])
          && request.resource.data.id == id
          && request.resource.data.route is string && request.resource.data.route.size() <= 100
          && request.resource.data.amount is number
          && optStr(request.resource.data, 'src', 40) && optStr(request.resource.data, 'srcName', 100)
          && optStr(request.resource.data, 'url', 2000) && optStr(request.resource.data, 'dates', 100)
          && optStr(request.resource.data, 'airline', 100) && optStr(request.resource.data, 'cur', 5)
          && optStr(request.resource.data, 'at', 40) && optStr(request.resource.data, 'by', 100)
          && (!('final' in request.resource.data) || request.resource.data.final is bool);
      }

      // Estadías anotadas: igual que los precios, solo para los miembros de la lista
      match /estadias/{id} {
        allow read, delete: if isMember(lid);
        allow create, update: if isMember(lid)
          && id.matches('[a-z0-9]{1,24}')
          && request.resource.data.keys().hasOnly(['id', 'src', 'srcName', 'url', 'city', 'name', 'checkin', 'checkout', 'amount', 'cur', 'at', 'by'])
          && request.resource.data.id == id
          && request.resource.data.city is string && request.resource.data.city.size() <= 100
          && request.resource.data.amount is number
          && request.resource.data.checkin is string && request.resource.data.checkin.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && request.resource.data.checkout is string && request.resource.data.checkout.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && optStr(request.resource.data, 'src', 40) && optStr(request.resource.data, 'srcName', 100)
          && optStr(request.resource.data, 'url', 2000) && optStr(request.resource.data, 'name', 100)
          && optStr(request.resource.data, 'cur', 5) && optStr(request.resource.data, 'at', 40) && optStr(request.resource.data, 'by', 100);
      }
    }
  }
}
